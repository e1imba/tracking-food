AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Google Cloud Console > OAuth client (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local development PostgreSQL only. Set in shell for Drizzle CLI (not auto-loaded from .env.local).
